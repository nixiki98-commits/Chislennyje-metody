import math

def relative_error (approx, exact):
 return abs (approx - exact) / abs(exact) if exact else float ('inf')

def absol_error (approx, exact):
 return abs (approx - exact)

print (absol_error(3.14, math.pi), relative_error (3.14, math.pi))
print (absol_error(0.1 + 0.2, 0.3), relative_error (0.1 + 0.2, 0.3))
vals = [0.1] * 1_000_000
naive = sum (vals)
exact = math.fsum (vals)
print (absol_error(naive, exact))
print (relative_error (naive, exact))
